[
  {
    "id": "fx-benign-pinned-config-github",
    "name": "github",
    "origin": {
      "kind": "config",
      "client": "claude-desktop",
      "config_path": "~/Library/Application Support/Claude/claude_desktop_config.json",
      "ref": "github"
    },
    "server_info": {
      "name": "github",
      "version": "1.0.0"
    },
    "tools": [],
    "tools_listed": false,
    "launch": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github@2025.4.8"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },
  {
    "id": "fx-benign-pinned-config-fetch",
