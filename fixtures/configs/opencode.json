{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "local-db": { "type": "local", "command": ["npx", "-y", "db-mcp@3.0.0", "--readonly"], "environment": { "DB_URL": "{env:DB_URL}" }, "enabled": true },
    "remote-kb": { "type": "remote", "url": "https://kb.example.com/mcp", "headers": { "Authorization": "Bearer {env:KB_TOKEN}" } }
  }
}
